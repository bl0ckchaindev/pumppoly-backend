# ============================================================================
# PumpPoly Backend — environment template
# Copy to ".env" and fill in YOUR OWN values. Never commit the real .env.
#   cp .env.example .env     (or: cp env.example .env on Windows)
# ============================================================================

# ---- Server ----
PORT=3010
NODE_ENV=production
HOST=0.0.0.0
# Public URL of the frontend (used for CORS). Comma-separate extra origins in CORS_ORIGINS.
FRONTEND_URL=https://your-frontend-domain.com
# CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Admin key protecting the sensitive admin endpoints (POST /update-global-config,
# PATCH /reward-distribution/config). Send it as `x-admin-key: <key>` or `Authorization: Bearer <key>`.
# REQUIRED for those endpoints — if unset they return 503 (locked). Use a long random string.
ADMIN_API_KEY=generate-a-long-random-secret

# ---- Supabase (PostgreSQL) ----
# Use the SERVICE ROLE key (server-side, secret) — NOT the anon key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ============================================================================
# EVM (Base mainnet = 8453)
# ============================================================================
NET_ID=8453
# Base mainnet RPC (HTTPS required, WSS recommended for the event listener).
HTTP_RPC_URL=https://mainnet.base.org
WS_RPC_URL=wss://YOUR_BASE_MAINNET_WS_RPC
# Optional separate RPC for price oracle reads (defaults to HTTP_RPC_URL if unset).
ORACLE_RPC_URL=https://mainnet.base.org

# FactoryUpgradeable proxy address (from your contract deployment).
CONTRACT_ADDRESS=0xYOUR_FACTORY_PROXY_ADDRESS
# Block number the Factory was deployed at — the indexer starts catch-up here.
FACTORY_DEPLOY_BLOCK=0
# DB chain slug for this EVM deployment. MUST match the frontend mapping (8453 -> "base").
EVM_CHAIN_SLUG=base

# ---- EVM keys (KEEP SECRET) ----
# Generic deployer/operator key used by some scripts (optional if unused).
PRIVATE_KEY=your-evm-operator-private-key
# Treasury key that funds trader/creator reward payouts on EVM.
EVM_TREASURY_PRIVATE_KEY=your-evm-treasury-private-key
# RewardClaim contract + the signer whose key the backend uses to sign claim vouchers.
REWARD_CLAIM_ADDRESS=0xYOUR_REWARD_CLAIM_ADDRESS
REWARD_SIGNER_PRIVATE_KEY=your-reward-signer-private-key

# ============================================================================
# Solana (mainnet-beta)
# ============================================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Treasury wallet secret key as a JSON byte array. KEEP SECRET. This wallet SIGNS the config
# init/update (so it must be the config OWNER) and funds reward payouts. For the role handover,
# run scripts/init-solana-config.js signed by the owner wallet, then scripts/set-solana-roles.js.
# Example shape (DO NOT use this — generate your own): [12,34,56, ... 64 numbers ...]
SOLANA_TREASURY_PRIVATE_KEY=[]
# Optional: graduation threshold in lamports (prod = 85 SOL). Defaults to 85 SOL; a mainnet RPC
# refuses a sub-10 SOL value.
# REAL_SOL_THRESHOLD_LAMPORTS=85000000000

# ---- Solana role addresses (base58 public addresses) ----
# fee_recipient — receives protocol fees. Set at init (scripts/init-solana-config.js) + handover.
FEE_RECIPIENT=YOUR_SOLANA_FEE_RECEIVER
# Final roles applied by scripts/set-solana-roles.js (signed by the current owner):
SOLANA_CONFIG_OWNER=YOUR_SOLANA_CONFIG_OWNER
SOLANA_MIGRATOR=YOUR_SOLANA_MIGRATOR
SOLANA_FEE_RECIPIENT=YOUR_SOLANA_FEE_RECEIVER

# ============================================================================
# Bonding-curve parameters (EVM, in wei)  — production values
# ============================================================================
# Graduation threshold: 10 ETH
BONDING_LIMIT=10000000000000000000
# Virtual ETH liquidity: 3.5 ETH
VIRTUAL_ETH_LP_INITIAL=3500000000000000000
# Real token liquidity seeded into the curve: 200,000,000 tokens (18 decimals)
REAL_TOKEN_LP_INITIAL=200000000000000000000000000
# Optional advanced overrides (leave unset to use contract/code defaults):
# VIRTUAL_TOKEN_LP_INITIAL=
# REAL_ETH_LP_INITIAL=

# ============================================================================
# Notifications (optional)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
