# PumpPoly Backend — environment template. Copy to .env and fill in your own values.
#   cp .env.example .env

# ---- Server ----
PORT=3010
NODE_ENV=production
HOST=0.0.0.0
# CORS allowlist is hardcoded in src/index.js; set CORS_ORIGINS only to allow another origin.
# CORS_ORIGINS=https://your-frontend-domain.com

# ---- Admin (protects /update-global-config + /reward-distribution/config; 503 until set) ----
ADMIN_API_KEY=generate-a-long-random-secret

# ---- Supabase (use the service_role key, not anon) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- EVM (Base mainnet, 8453) ----
NET_ID=8453
# WSS is required for the event listener.
HTTP_RPC_URL=https://mainnet.base.org
WS_RPC_URL=wss://YOUR_BASE_MAINNET_WS_RPC
ORACLE_RPC_URL=https://mainnet.base.org
CONTRACT_ADDRESS=0xYOUR_FACTORY_PROXY_ADDRESS
FACTORY_DEPLOY_BLOCK=0
EVM_CHAIN_SLUG=base
REWARD_CLAIM_ADDRESS=0xYOUR_REWARD_CLAIM_ADDRESS
# Must be the private key of the RewardClaim.signer.
REWARD_SIGNER_PRIVATE_KEY=your-reward-signer-private-key

# ---- Key vault (secure_keys table) ----
# Decrypts keys stored encrypted in the DB via scripts/store-owner-key.js (enables the fully
# automatic Solana fee sweep). Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Solana (mainnet-beta) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# 64-number secret key of the claim TREASURY wallet (pays trader-reward claims; co-signs claim txs).
# This is NOT the config owner — the owner role stays with the client's wallet, which runs
# scripts/sweep-protocol-fees.js to move vault fees. See that script for the funding flow.
SOLANA_TREASURY_PRIVATE_KEY=[]
# Where the backend forwards the platform's share after unwrapping swept fees in the treasury
# (only used when the client sweeps with fee_recipient = treasury). The reward share stays put.
SOLANA_PLATFORM_FEE_WALLET=YOUR_SOLANA_FEE_RECEIVER
FEE_RECIPIENT=YOUR_SOLANA_FEE_RECEIVER
SOLANA_CONFIG_OWNER=YOUR_SOLANA_CONFIG_OWNER
SOLANA_MIGRATOR=YOUR_SOLANA_MIGRATOR
SOLANA_FEE_RECIPIENT=YOUR_SOLANA_FEE_RECEIVER
# REAL_SOL_THRESHOLD_LAMPORTS=85000000000   (default 85 SOL)

# ---- Bonding curve (EVM, wei): 10 ETH graduation / 3.5 ETH virtual LP / 200M token real LP ----
BONDING_LIMIT=10000000000000000000
VIRTUAL_ETH_LP_INITIAL=3500000000000000000
REAL_TOKEN_LP_INITIAL=200000000000000000000000000
# Optional overrides (leave unset for code defaults): VIRTUAL_TOKEN_LP_INITIAL, REAL_ETH_LP_INITIAL
